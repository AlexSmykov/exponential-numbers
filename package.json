{
  "name": "exponential-number",
  "version": "2.0.0",
  "description": "Small package with class to work with big numbers. This class allows to work with 1e...(1.8e308)...e1e100",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "url": "git+https://github.com/AlexSmykov/exponential-numbers.git"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "prebuild": "npm run lint && npm test",
    "build": "tsc",
    "test": "jest --config=jest.config.js test.ts",
    "prepublishOnly": "npm run build",
    "update": "npm login && npm publish"
  },
  "keywords": [
    "typescript",
    "numbers",
    "big-numbers",
    "utils",
    "exponent"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": false
}
